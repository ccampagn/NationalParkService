<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="NationalParkServiceAPI.Tests/**/*.cs" />
    <Content Remove="NationalParkServiceAPI.Tests/**/*" />
    <None Remove="NationalParkServiceAPI.Tests/**/*" />
    
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <!-- Not used directly. Overrides the 9.0.11 that Microsoft.Data.SqlClient pulls in, which has known vulnerabilities
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Can be removed once SqlClient depends on a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>
</Project>
